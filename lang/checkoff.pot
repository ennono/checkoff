msgid "General"
msgstr ""

#: includes/class-checkoff-settings.php:113
msgid "Where checklists are shown and who may create them."
msgstr ""

#: includes/class-checkoff-settings.php:117
msgid "Checklist page"
msgstr ""

#: includes/class-checkoff-settings.php:118
msgid "The page that contains the [cko_app] or [cko_checklist] shortcode. Links to checklists and the \"Open\" form lead there. Without one, they lead to the page the form is on."
msgstr ""

#: includes/class-checkoff-settings.php:125
msgid "Guests may create checklists"
msgstr ""

#: includes/class-checkoff-settings.php:126
msgid "Off: only logged-in users can create checklists. Opening and ticking existing checklists by their ID is always possible."
msgstr ""

#: includes/class-checkoff-settings.php:133
msgid "Offer templates"
msgstr ""

#: includes/class-checkoff-settings.php:134
msgid "Show the templates in the form that creates a checklist. To make a template, build a checklist on the website and mark it as a template on its screen under CheckOff → All Checklists."
msgstr ""

