msgid "Maintenance"
msgstr ""

#: includes/class-checkoff-settings.php:328
msgid "Cleanup and uninstall."
msgstr ""

#: includes/class-checkoff-settings.php:332
msgid "Delete unused checklists"
msgstr ""

#: includes/class-checkoff-settings.php:333
msgid "Days without being opened after which a checklist is deleted automatically (checked once a day). 0 = never."
msgstr ""

#: includes/class-checkoff-settings.php:342
msgid "Delete checklists on uninstall"
msgstr ""

#: includes/class-checkoff-settings.php:343
msgid "When the plugin is deleted, also delete all checklists. Settings are always removed."
msgstr ""

