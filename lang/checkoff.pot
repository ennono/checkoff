#. Plugin Name of the plugin
#: checkoff.php
msgid "CheckOff"
msgstr ""

#. Description of the plugin
#: checkoff.php
msgid "Let visitors build their own multi-level checklists from building blocks — simple lists, lists with due dates or \"not needed\", weekday lists, ratings, measurements, choices, counters and notes — and tick them off."
msgstr ""

